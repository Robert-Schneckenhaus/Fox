namespace FoxCompression;

using System;

// CRC-32 (the polynomial of zip, gzip and PNG: 0xEDB88320 reflected), 8 bytes per step with 8 tables
// ("slice-by-8"), several times faster than one table lookup per byte. Gives the same values as
// System.Compression.Crc32.
uint32[] _CrcTables = _MakeCrcTables();

uint32[] _MakeCrcTables()
{
    var t = new uint32[8 * 256];
    for (var i = 0; i < 256; i += 1)
    {
        uint32 c = (uint32)i;
        for (var k = 0; k < 8; k += 1)
            c = (c & 1) != 0 ? 0xEDB88320u ^ (c >> 1) : c >> 1;
        t[i] = c;
    }
    for (var i = 0; i < 256; i += 1)
    {
        for (var k = 1; k < 8; k += 1)
        {
            uint32 prev = t[(k - 1) * 256 + i];
            t[k * 256 + i] = (prev >> 8) ^ t[(int)(prev & 0xFF)];
        }
    }
    return t;
}

unsafe uint32 _Crc32(ReadOnlySlice<uint8> data)
{
    uint32 c = 0xFFFFFFFFu;
    int n = data.Length;
    if (n == 0)
        return 0;
    uint8* p = data.Ptr();
    uint32* t = _CrcTables[0..].Ptr();
    while (n >= 8)
    {
        uint32 lo = _Load32(p) ^ c;
        uint32 hi = _Load32(p + 4);
        c = t[7 * 256 + (int)(lo & 0xFF)] ^ t[6 * 256 + (int)((lo >> 8) & 0xFF)]
            ^ t[5 * 256 + (int)((lo >> 16) & 0xFF)] ^ t[4 * 256 + (int)(lo >> 24)]
            ^ t[3 * 256 + (int)(hi & 0xFF)] ^ t[2 * 256 + (int)((hi >> 8) & 0xFF)]
            ^ t[256 + (int)((hi >> 16) & 0xFF)] ^ t[(int)(hi >> 24)];
        p += 8;
        n -= 8;
    }
    while (n > 0)
    {
        c = t[(int)((c ^ p[0]) & 0xFF)] ^ (c >> 8);
        p += 1;
        n -= 1;
    }
    return ~c;
}
